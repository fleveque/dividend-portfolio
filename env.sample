# Copy to .env (gitignored) and fill in. Loaded by direnv via .envrc.

# === Deploy bootstrap (Bitwarden) ===
# All deploy secrets are pulled from Bitwarden by .kamal/secrets. Set these
# four; the deploy workflow logs in + unlocks the vault and passes a
# BW_SESSION through to kamal. For local kamal use, first run:
#   bw config server https://vault.bitwarden.eu   # one-time per machine
#   bw login --apikey                              # uses BW_CLIENTID/SECRET
#   export BW_SESSION=$(bw unlock --raw --passwordenv BW_PASSWORD)
# Then any `bundle exec kamal ...` call works.
# (To switch back to 1Password, see .kamal/secrets.1password.example.)
BW_ACCOUNT=your_bitwarden_login_email
BW_CLIENTID=your_bitwarden_personal_api_client_id
BW_CLIENTSECRET=your_bitwarden_personal_api_client_secret
BW_PASSWORD=your_bitwarden_master_password

# === Local dev app config ===

# Financial data providers API keys
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key

# Vite configuration
VITE_RUBY_HOST=0.0.0.0

# Logo service for stock logos (self-hosted)
VITE_LOGO_SERVICE_URL=https://logos.quantic.es
VITE_LOGO_SERVICE_API_KEY=your_logo_service_api_key

# Pulse (sibling sharing app) — override per env (e.g. beta-pulse.quantic.es).
# Defaults to https://pulse.quantic.es when unset, so this is optional.
VITE_PULSE_URL=https://pulse.quantic.es

# NATS (for Pulse real-time event integration)
NATS_URL=nats://nats:4222

# Stock refresh schedule (optional - for periodic background refresh)
# Uses Solid Queue recurring format, e.g. "every 4 hours", "every 30 minutes"
# Quote the value — direnv's dotenv parser rejects unquoted spaces.
STOCK_REFRESH_SCHEDULE="every 24 hours"

# Google OAuth (optional - for "Sign in with Google")
# Get credentials at https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:3000/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini AI (for AI portfolio insights — optional)
GEMINI_API_KEY=your_gemini_api_key
